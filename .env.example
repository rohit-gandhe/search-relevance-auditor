# Copy to .env and fill in. Nothing here is needed for the offline path:
#   ./gradlew test
#   ./gradlew run --args="eval"
#   ./gradlew run --args="ui"
# The 617-product slice, the judgements and the renders are all in the repo.

# --- the agent ---------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Slack: one app, Socket Mode ON ------------------------------------
# Scopes: chat:write, reactions:write, channels:read. The bot must be a
# member of BOTH channels — chat:write.public does not cover reactions,
# and a bot that can post can still fail to react.
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_SIGNING_SECRET=
SLACK_APPROVALS_CHANNEL=
SLACK_ARCHIVE_CHANNEL=

# How long the approval card survives after the work completes.
#   -1  keep it, so the finished trail stays on screen
#    0  delete the instant it completes
#   10  long enough to read the trail, then clear the channel
ARCHIVE_DELETE_DELAY_SECONDS=10

# --- AWS: ./infra/deploy.sh creates these, --write-env fills them in ----
AWS_REGION=us-west-2
DECISIONS_TOPIC_ARN=
ENRICHMENT_QUEUE_URL=
DEAD_LETTER_QUEUE_URL=

# --- Google Sheets -----------------------------------------------------
# Share the sheet with the service account's client_email.
GOOGLE_SA_KEY=./secrets/service-account.json
SHEET_ID=
SHEET_TAB=decisions

# --- GitHub ------------------------------------------------------------
# No token here: the publisher shells out to `gh`, which holds the
# credential in the system keyring and refreshes it.
GITHUB_REPO=
GITHUB_BASE=main

# --- tuning: measured, not chosen --------------------------------------
DEMO_CATALOGUE=wands
MAX_TARGETS=260
AUTO_APPLY_THRESHOLD=0.80
SYNONYM_WEIGHT=0.4
